{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sobix-grafikgaestebuch",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "grafikgaestebuch", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "./migrations" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
